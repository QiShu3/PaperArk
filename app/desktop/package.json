{
  "name": "paperark-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare:dist": "node scripts/prepare-dist.mjs",
    "fetch:prebuilt": "node scripts/fetch-prebuilt.mjs",
    "dist:win": "node scripts/prepare-dist.mjs && node scripts/fetch-prebuilt.mjs && npm run build && electron-builder --win",
    "smoke": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fast-glob": "^3.3.2",
    "fast-xml-parser": "^5.2.5",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "42.9.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
